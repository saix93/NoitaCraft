{
  "schemaVersion": 1,
  "mode": "installed",
  "games": [
    {
      "slug": "custom-magicraft",
      "role": "primary"
    },
    {
      "slug": "noita",
      "role": "companion"
    }
  ],
  "components": [
    {
      "id": "main",
      "fileName": "NoitaCraft-*.zip",
      "label": "NoitaCraft",
      "kind": "main",
      "required": true
    }
  ],
  "requirements": [
    {
      "kind": "loader",
      "id": "bepinex-5"
    }
  ],
  "mappings": [
    {
      "component": "main",
      "from": "plugins/",
      "to": "{game}/BepInEx/plugins/NoitaCraft"
    },
    {
      "component": "main",
      "from": "vgmstream/",
      "to": "{localappdata}/NoitaCraft/vgmstream"
    }
  ],
  "launch": {
    "kind": "game"
  },
  "settings": [
    {
      "file": "{localappdata}/NoitaCraft/noita.env",
      "set": {
        "NOITA_DIR": "{game:noita}"
      }
    }
  ],
  "runtimeData": [
    "{localappdata}/NoitaCraft"
  ],
  "test": {
    "checks": [
      "noita-data",
      "spells-added",
      "mina-set",
      "noita-icons",
      "own-tooltip",
      "mina-look",
      "noita-in-pool",
      "noita-spell-cast",
      "noita-projectile",
      "noita-bounce",
      "noita-explosion",
      "noita-sound",
      "no-errors",
      "aim-follows",
      "wand-points-aim",
      "combo-triplicate-damage",
      "combo-noita-mod-magicraft-spell",
      "combo-magicraft-mod-noita-spell",
      "combo-noita-multicast-magicraft",
      "combo-magicraft-multicast-noita",
      "combo-divide-bomb",
      "combo-pierce-blackhole",
      "combo-heavy-speed-laser",
      "combo-volley-mixed",
      "combo-charges-nuke"
    ],
    "minutes": 9
  }
}